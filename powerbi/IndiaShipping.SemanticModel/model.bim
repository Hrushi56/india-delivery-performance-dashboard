{
  "name": "IndiaShipping",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "orders",
        "columns": [
          {
            "name": "order_id",
            "sourceColumn": "order_id",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "state",
            "sourceColumn": "state",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "mode",
            "sourceColumn": "mode",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "actual",
            "sourceColumn": "actual",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "scheduled",
            "sourceColumn": "scheduled",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "days_late",
            "sourceColumn": "days_late",
            "dataType": "int64",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Eligible Orders",
            "expression": "COUNTROWS(orders)",
            "formatString": "#,0"
          },
          {
            "name": "Late Orders",
            "expression": "COALESCE(CALCULATE([Eligible Orders], orders[days_late] > 0), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Late Rate",
            "expression": "DIVIDE([Late Orders], [Eligible Orders])",
            "formatString": "0.0%"
          },
          {
            "name": "Average Days Late",
            "expression": "CALCULATE(AVERAGE(orders[days_late]), orders[days_late] > 0)",
            "formatString": "0.0"
          }
        ],
        "partitions": [
          {
            "name": "orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Raw = Binary.FromText(\"\" & \"\" & \"\" & \"\" & \"\" & \"\" & \"\" & \"\" & \"\" & \"\" & \"\" & \"\" & \"\" & \"ZGFyZCBDbGFzcywzLDQsMA0KNzcxNjQsTWFoYXJhc2h0cmEsU2Vjb25kIENsYXNzLDUsMiwzDQo3NzE4MixNYWhhcmFzaHRyYSxTZWNvbmQgQ2xhc3MsMywyLDENCjc3MTg1LEFzc2FtLFN0YW5kYXJkIENsYXNzLDYsNCwyDQo3NzE5OCxEZWxoaSxGaXJzdCBDbGFzcywyLDEsMQ0K\", BinaryEncoding.Base64),",
                "    Data = Csv.Document(Raw, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Data),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"order_id\", type text}, {\"state\", type text}, {\"mode\", type text}, {\"actual\", Int64.Type}, {\"scheduled\", Int64.Type}, {\"days_late\", Int64.Type}})",
                "in Typed"
              ]
            }
          }
        ]
      }
    ]
  }
}
